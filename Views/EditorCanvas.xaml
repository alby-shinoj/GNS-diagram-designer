<UserControl x:Class="GsnDiagramEditor.Views.EditorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GsnDiagramEditor.Controls">
    <Grid>
        <ScrollViewer x:Name="DiagramScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F8FAFC"
                      PreviewMouseWheel="DiagramScrollViewer_OnPreviewMouseWheel">
            <Border Padding="40">
                <Grid x:Name="DiagramSurface"
                      Width="{Binding CanvasWidth}"
                      Height="{Binding CanvasHeight}"
                      MouseMove="DiagramSurface_OnMouseMove"
                      MouseLeftButtonUp="DiagramSurface_OnMouseLeftButtonUp"
                      MouseLeftButtonDown="DiagramSurface_OnMouseLeftButtonDown">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Grid.RenderTransform>
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,25,25" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,25,25" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="{x:Null}">
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#E5E7EB" Thickness="1" />
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0,0" EndPoint="25,0" />
                                                <LineGeometry StartPoint="0,0" EndPoint="0,25" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>

                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="0" />
                                <Setter Property="Canvas.Top" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ConnectionVisual Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           SourceX="{Binding SourceX}"
                                                           SourceY="{Binding SourceY}"
                                                           TargetX="{Binding TargetX}"
                                                           TargetY="{Binding TargetY}"
                                                           Label="{Binding Label}"
                                                           LineColor="{Binding LineColor}"
                                                           ThicknessValue="{Binding Thickness}"
                                                           IsDashed="{Binding IsDashed}"
                                                           IsSelected="{Binding IsSelected}"
                                                           MouseLeftButtonDown="ConnectionVisual_OnMouseLeftButtonDown" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:NodeVisual Width="{Binding Width}"
                                                     Height="{Binding Height}"
                                                     NodeType="{Binding Type}"
                                                     Title="{Binding Title}"
                                                     Description="{Binding Description}"
                                                     FillColor="{Binding FillColor}"
                                                     BorderColor="{Binding BorderColor}"
                                                     TextColor="{Binding TextColor}"
                                                     FontSizeValue="{Binding FontSize}"
                                                     IsSelected="{Binding IsSelected}"
                                                     Cursor="Hand"
                                                     MouseLeftButtonDown="NodeVisual_OnMouseLeftButtonDown" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
